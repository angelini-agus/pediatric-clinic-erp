# Variables de entorno para apps/landing (Astro)
# Copiá este archivo a .env.local y ajustá si hace falta.
# NUNCA commitees el archivo .env.local con valores reales.

# URL base del ERP (portal de pacientes). Default: http://localhost:3000
# Si el ERP corre en otro puerto (o en producción), overridear acá.
PUBLIC_ERP_URL=http://localhost:3000
