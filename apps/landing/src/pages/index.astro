---
import { AboutDoctorSection } from '../components/AboutDoctorSection';
import { ContactoSection } from '../components/ContactoSection';
import { FaqSection } from '../components/FaqSection';
import { HeroSection } from '../components/HeroSection';
import { JourneySection } from '../components/JourneySection';
import { LandingFooter } from '../components/LandingFooter';
import { LandingNavbar } from '../components/LandingNavbar';
import { TestimonialsSection } from '../components/TestimonialsSection';
import { TurnosSection } from '../components/TurnosSection';
import '../styles/global.css';

const SITE_URL = 'https://ipedierp.com.ar';
const TITLE = 'iPediERP — Dra. Martinangelio | Pediatra en Pueblo Esther';
const DESCRIPTION =
  'Consultorio pediátrico de la Dra. Martinangelio en Pueblo Esther. Jefa del Servicio de Pediatría del Hospital Eva Perón. Atención personalizada y seguimiento integral.';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta
      name="keywords"
      content="clínica pediátrica, pediatra, turno pediátrico, salud infantil, pediatría argentina"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="iPediERP" />
    <meta name="theme-color" content="#EAF6F0" />
    <link rel="canonical" href={SITE_URL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="iPediERP" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}/hero-doctor.jpg`} />
    <meta property="og:image:alt" content="Dra. Martinangelio — Pediatra Jefe de iPediERP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/hero-doctor.jpg`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Bricolage Grotesque (display) + Plus Jakarta Sans (sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Plus+Jakarta+Sans:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --font-bricolage: 'Bricolage Grotesque', system-ui, sans-serif;
        --font-jakarta: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>
  <body class="font-sans antialiased bg-paper text-ink-700">
    <!--
      Hero wrapper: fondo menta #EAF6F0, posición relativa para el wave superpuesto.
      min-h-[100dvh] asegura altura mínima de viewport sin depender del navbar
      (que ahora es fixed y no ocupa espacio en el flujo).
    -->
    <!--
      overflow:visible permite que la foto de la Dra. (z-30 en HeroSection)
      se extienda hacia abajo del corte recto, atravesando la línea entre
      el fondo menta y el fondo oscuro de AboutDoctorSection.
      h-[100dvh]: el hero ocupa exactamente un viewport, nunca más.
    -->
    <div class="font-sans h-[100dvh] w-full flex flex-col relative" style="background-color: #EAF6F0; overflow: visible;">
      <LandingNavbar client:load />
      <HeroSection />
    </div>

    <AboutDoctorSection />

    <!--
      Wave divider: transición del bloque oscuro (#16192a) de vuelta a menta (#EAF6F0).
      El wave va en el borde inferior de AboutDoctorSection.
      Solo 2 waves en toda la página: este y el de arriba — no más.
    -->
    <div style="background-color: #16192a; line-height: 0;">
      <svg
        aria-hidden="true"
        viewBox="0 0 1440 56"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
        style="display:block; width:100%; height:56px;"
      >
        <path
          d="M0,28 C240,56 480,56 720,28 C960,0 1200,0 1440,28 L1440,56 L0,56 Z"
          fill="#EAF6F0"
        />
      </svg>
    </div>

    <JourneySection />
    <FaqSection />
    <TestimonialsSection />
    <TurnosSection />
    <ContactoSection />
    <LandingFooter />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll(
          '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-x, .reveal-float'
        );
        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                io.unobserve(entries[i].target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        for (var i = 0; i < els.length; i++) io.observe(els[i]);
      })();
    </script>
  </body>
</html>