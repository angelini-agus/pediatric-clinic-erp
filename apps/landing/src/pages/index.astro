---
import { AboutDoctorSection } from '../components/about-doctor-section';
import { ContactoSection } from '../components/contacto-section';
import { FaqSection } from '../components/faq-section';
import { HeroSection } from '../components/hero-section';
import { InstitutionalBand } from '../components/institutional-band';
import { JourneySection } from '../components/journey-section';
import { LandingFooter } from '../components/landing-footer';
import { LandingNavbar } from '../components/landing-navbar';
import { TestimonialsSection } from '../components/testimonials-section';
import { TurnosSection } from '../components/turnos-section';
import { WhatsAppFloat } from '../components/whatsapp-float';
import { CLINIC_INFO } from '../config';
import '../styles/global.css';

const SITE_URL = Astro.site?.origin ?? 'https://www.dramartinangelio.com';
const TITLE = `${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor} | ${CLINIC_INFO.doctorFullName}, Pediatra en Pueblo Esther`;
const DESCRIPTION =
  'Pediatra en Pueblo Esther. La misma médica de la preconcepción a la adolescencia. Recibida en 2014, con experiencia en guardia de urgencias y recepción de recién nacidos. Sacá turno online.';

// ── Datos estructurados (schema.org/Physician) ──────────────────────
const PHYSICIAN_JSON_LD = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: `${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor}`,
  alternateName: `${CLINIC_INFO.doctorFullName} — Pediatra en Pueblo Esther`,
  description: DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}/og-banner.jpg`,
  logo: `${SITE_URL}/apple-touch-icon.png`,
  medicalSpecialty: 'Pediatric',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pueblo Esther',
    addressLocality: 'Pueblo Esther',
    addressRegion: 'Santa Fe',
    addressCountry: 'AR',
  },
  areaServed: { '@type': 'City', name: 'Pueblo Esther' },
  telephone: '+5493413464378',
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta
      name="keywords"
      content="Miradas, pediatra Pueblo Esther, consultorios de pediatría integral, pediatra particular Rosario, pediatra zona sur, consultorio pediátrico, salud infantil, pediatría argentina"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={`${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor}`} />
    <meta name="theme-color" content="#E96B3A" />
    <link rel="canonical" href={SITE_URL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={CLINIC_INFO.brand} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}/og-banner.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor} | ${CLINIC_INFO.doctorFullName}`}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og-banner.jpg`} />
    <meta
      name="twitter:image:alt"
      content={`${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor} | ${CLINIC_INFO.doctorFullName}`}
    />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Datos estructurados (Physician) para rich snippets de búsqueda local -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(PHYSICIAN_JSON_LD)} />

    <!-- Fonts self-hosted (woff2 subset latin, ver global.css): preload de
         las críticas — Fraunces renderiza los headings (LCP) y Nunito Sans
         el body. Pacifico es decorativa y carga cuando se usa. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/fraunces-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/nunito-sans-latin.woff2"
      crossorigin
    />

    <style is:global>
      :root {
        --font-heading: 'Fraunces', Georgia, 'Times New Roman', serif;
        --font-body: 'Nunito Sans', system-ui, sans-serif;
        --font-script: 'Pacifico', cursive;
      }
      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        overflow-x: hidden;
        max-width: 100%;
      }
    </style>
  </head>
  <body class="font-sans antialiased bg-paper text-choco overflow-x-hidden">
    <!--
      Hero wrapper: fondo crema #F4EEDF.
      min-h-[100dvh] en mobile asegura que el contenido respire sin desbordar;
      lg:h-[100dvh] mantiene el viewport exacto en desktop según la referencia.
      overflow-x-clip previene scroll horizontal sin bloquear el overflow vertical
      necesario para el corte inferior en desktop.
    -->
    <div class="font-sans min-h-[100dvh] lg:h-[100dvh] w-full flex flex-col relative overflow-x-clip" style="background-color: #F4EEDF;">
      <LandingNavbar client:load />
      <HeroSection />
    </div>

    <AboutDoctorSection />
    <InstitutionalBand />

    <JourneySection client:visible />
    <FaqSection />
    <TestimonialsSection />
    <TurnosSection />
    <ContactoSection />
    <LandingFooter />
    <WhatsAppFloat />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll(
          '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-x, .reveal-float'
        );
        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                io.unobserve(entries[i].target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        for (var i = 0; i < els.length; i++) io.observe(els[i]);
      })();
    </script>
  </body>
</html>