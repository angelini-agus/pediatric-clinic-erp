---
import { AboutDoctorSection } from '../components/about-doctor-section';
import { ContactoSection } from '../components/contacto-section';
import { FaqSection } from '../components/faq-section';
import { HeroSection } from '../components/hero-section';
import { InstitutionalBand } from '../components/institutional-band';
import { JourneySection } from '../components/journey-section';
import { LandingFooter } from '../components/landing-footer';
import { LandingNavbar } from '../components/landing-navbar';
import { TestimonialsSection } from '../components/testimonials-section';
import { TurnosSection } from '../components/turnos-section';
import { WhatsAppFloat } from '../components/whatsapp-float';
import { CLINIC_INFO } from '../config';
import '../styles/global.css';

const SITE_URL = Astro.site?.origin ?? 'https://dramartinangelio.com';
const TITLE = `${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor} | ${CLINIC_INFO.doctorFullName}, Pediatra en Pueblo Esther`;
const DESCRIPTION =
  'Pediatra en Pueblo Esther. La misma médica de la preconcepción a la adolescencia. Recibida en 2014, con experiencia en guardia de urgencias y recepción de recién nacidos. Sacá turno online.';

// ── Datos estructurados (schema.org/Physician) ──────────────────────
const PHYSICIAN_JSON_LD = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: `${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor}`,
  alternateName: `${CLINIC_INFO.doctorFullName} — Pediatra en Pueblo Esther`,
  description: DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}/hero-doctor.jpg`,
  medicalSpecialty: 'Pediatric',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Pueblo Esther',
    addressLocality: 'Pueblo Esther',
    addressRegion: 'Santa Fe',
    addressCountry: 'AR',
  },
  areaServed: { '@type': 'City', name: 'Pueblo Esther' },
  telephone: '+5493413464378',
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta
      name="keywords"
      content="Miradas, pediatra Pueblo Esther, consultorios de pediatría integral, pediatra particular Rosario, pediatra zona sur, consultorio pediátrico, salud infantil, pediatría argentina"
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={`${CLINIC_INFO.brand} — ${CLINIC_INFO.descriptor}`} />
    <meta name="theme-color" content="#F4EEDF" />
    <link rel="canonical" href={SITE_URL} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={CLINIC_INFO.brand} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}/hero-doctor.jpg`} />
    <!-- TODO (Agus): reemplazar por una imagen OG dedicada de 1200x630 -->
    <meta property="og:image:width" content="896" />
    <meta property="og:image:height" content="1200" />
    <meta
      property="og:image:alt"
      content={`${CLINIC_INFO.doctorFullName} — Pediatra en Pueblo Esther`}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/hero-doctor.jpg`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <!-- TODO (Agus): agregar apple-touch-icon.png (180x180) en /public y linkearlo acá -->

    <!-- Datos estructurados (Physician) para rich snippets de búsqueda local -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(PHYSICIAN_JSON_LD)} />

    <!-- Fonts: Fraunces (heading serif chunky) + Pacifico (script) + Nunito Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700;800&family=Pacifico&family=Nunito+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --font-heading: 'Fraunces', Georgia, 'Times New Roman', serif;
        --font-body: 'Nunito Sans', system-ui, sans-serif;
        --font-script: 'Pacifico', cursive;
      }
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>
  <body class="font-sans antialiased bg-paper text-choco">
    <!--
      Hero wrapper: fondo crema #F4EEDF, posición relativa para el wave superpuesto.
      min-h-[100dvh] asegura altura mínima de viewport sin depender del navbar
      (que ahora es fixed y no ocupa espacio en el flujo).
    -->
    <!--
      overflow:visible permite que la foto de la Dra. (z-30 en HeroSection)
      se extienda hacia abajo del corte recto, atravesando la línea entre
      el fondo menta y el fondo oscuro de AboutDoctorSection.
      h-[100dvh]: el hero ocupa exactamente un viewport, nunca más.
    -->
    <div class="font-sans h-[100dvh] w-full flex flex-col relative" style="background-color: #F4EEDF; overflow: visible;">
      <LandingNavbar client:load />
      <HeroSection />
    </div>

    <AboutDoctorSection />
    <InstitutionalBand />

    <JourneySection client:visible />
    <FaqSection />
    <TestimonialsSection />
    <TurnosSection />
    <ContactoSection />
    <LandingFooter />
    <WhatsAppFloat />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var els = document.querySelectorAll(
          '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-x, .reveal-float'
        );
        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                io.unobserve(entries[i].target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        for (var i = 0; i < els.length; i++) io.observe(els[i]);
      })();
    </script>
  </body>
</html>