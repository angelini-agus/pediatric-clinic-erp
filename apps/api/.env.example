# Variables de entorno para apps/api
# Copiá este archivo a .env y completá los valores
# NUNCA commitees el archivo .env con valores reales

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
API_PREFIX=api

# ── Base de datos (PostgreSQL) ────────────────────────────────
# Para desarrollo local con Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pediatric_erp_dev

# ── JWT ──────────────────────────────────────────────────────
# CRÍTICO: Cambiar en producción. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_EN_PRODUCCION_minimo_32_caracteres_secreto_muy_largo
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Origin del frontend (apps/web)
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30

# ── Logging ──────────────────────────────────────────────────
# Opciones: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
