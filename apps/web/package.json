{
  "name": "@pediatric-erp/web",
  "version": "0.0.1",
  "private": true,
  "description": "Next.js web application — Pediatric Clinic ERP",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
