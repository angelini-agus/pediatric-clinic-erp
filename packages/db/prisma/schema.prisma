// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Output to node_modules/@prisma/client (default)
  // For monorepo, ensure postinstall generates the client
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GLOBAL ARCHITECTURE RULES (Law 26.529 + RBAC)
// ============================================================
//
// 1. MANDATORY SOFT DELETE
//    - Every model MUST include `deletedAt DateTime?`
//    - Use Prisma middleware or extension to automatically filter
//      deleted records.
//    - NEVER use hard DELETE in production for clinical data.
//
// 2. AUDITING (Immutability - Law 26.529)
//    - AuditLog table: { id, entityName, entityId, action, payload Json, userId, patientId, createdAt }
//    - AuditLog is APPEND-ONLY: no updates, no soft-delete.
//
// 3. STANDARD TIMESTAMPS
//    - Every model includes: createdAt DateTime @default(now())
//    - Every model includes: updatedAt DateTime @updatedAt
//    - Every model includes: deletedAt DateTime?
//
// ============================================================
// DOMAIN ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  SECRETARY
  PATIENT
}

enum AppointmentStatus {
  /// Requested by the patient from the portal — pending staff confirmation.
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// ============================================================
// DOMAIN MODELS
// ============================================================

model User {
  id             String          @id @default(cuid())
  email          String          @unique @db.VarChar(200)
  password       String          @db.VarChar(200)
  fullName       String          @db.VarChar(200)
  role           UserRole        @default(DOCTOR)
  specialty      String?         @db.VarChar(100)
  medicalLicense String?         @db.VarChar(50)
  phone          String?         @db.VarChar(30)

  // Relations
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  /// Portal account linked to this patient record (role PATIENT).
  patient        Patient?

  // Standard timestamps (Global Architecture)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([role, deletedAt])
  @@index([deletedAt])

  @@map("users")
}

model Patient {
  id                    String          @id @default(cuid())

  // Personal data
  firstName             String          @db.VarChar(100)
  lastName              String          @db.VarChar(100)
  documentType          String          @db.VarChar(10)   @default("DNI")
  /// Nullable: fichas created from the patient portal may not have the DNI
  /// yet — the clinic completes it during the first visit. The staff
  /// creation flow still requires it (patientCreateSchema).
  documentNumber        String?         @db.VarChar(20)
  dateOfBirth           DateTime
  biologicalSex         String          @db.VarChar(10)

  // Optional clinical data
  bloodGroup            String?         @db.VarChar(5)

  // Health Insurance / Obra Social
  healthInsurance       String?         @db.VarChar(100)
  healthInsurancePlan   String?         @db.VarChar(50)
  healthInsuranceNumber String?         @db.VarChar(50)

  // Primary guardian
  guardianFullName      String          @db.VarChar(200)
  guardianPhone         String          @db.VarChar(30)
  guardianEmail         String?         @db.VarChar(200)
  guardianRelationship  String          @db.VarChar(20)

  // Perinatal background
  birthWeightGrams      Int?
  gestationalWeeks      Int?
  apgarScore            String?         @db.VarChar(10)

  // Relations
  appointments          Appointment[]
  medicalRecords        MedicalRecord[]
  prescriptions         Prescription[]
  /// Portal account linked to this record (role PATIENT). Unique: one
  /// account per patient record. Null until staff links it.
  userId                String?         @unique
  user                  User?           @relation(fields: [userId], references: [id])

  // Standard timestamps (Global Architecture)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  @@index([documentNumber])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("patients")
}

model Appointment {
  id        String            @id @default(cuid())
  dateTime  DateTime
  type      String            @db.VarChar(100)
  notes     String?           @db.Text
  status    AppointmentStatus @default(SCHEDULED)

  // Relations
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User              @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // Standard timestamps (Global Architecture)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  @@index([dateTime])
  @@index([doctorId, dateTime])
  @@index([patientId])
  @@index([status, deletedAt])
  @@index([deletedAt])
  @@map("appointments")
}

model MedicalRecord {
  id           String    @id @default(cuid())
  diagnosis    String    @db.VarChar(500)
  notes        String    @db.Text
  treatment    String?   @db.Text
  prescription String?   @db.Text

  // Relations
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // Standard timestamps (Law 26.529: Medical records are immutable)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([patientId, createdAt])
  @@index([doctorId])
  @@index([deletedAt])

  @@map("medical_records")
}

model Prescription {
  id           String    @id @default(cuid())
  medication   String    @db.VarChar(500)
  dosage       String    @db.VarChar(200)
  instructions String    @db.Text

  // Relations
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // Standard timestamps (Immutable legal prescriptions)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("prescriptions")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   @db.VarChar(100)
  entityName String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  userId     String   @db.VarChar(100)
  patientId  String?  @db.VarChar(100)
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityId, entityName])
  @@index([userId])
  @@index([patientId])
  @@index([createdAt])

  @@map("audit_logs")
}

model ClinicSettings {
  id            String    @id @default("singleton")
  fullName      String    @db.VarChar(200)
  licenseNumber String    @db.VarChar(50)
  specialty     String    @db.VarChar(100)
  clinicName    String    @db.VarChar(200)
  /// Exact address, shown to registered patients in the portal (the public
  /// landing only publishes the city).
  address       String?   @db.VarChar(300)

  // Standard timestamps (Global Architecture)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@map("clinic_settings")
}

