// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Output to node_modules/@prisma/client (default)
  // For monorepo, ensure postinstall generates the client
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GLOBAL ARCHITECTURE RULES (Law 26.529 + RBAC)
// ============================================================
//
// 1. MANDATORY SOFT DELETE
//    - Every model MUST include `deletedAt DateTime?`
//    - Use Prisma middleware or extension to automatically filter
//      deleted records.
//    - NEVER use hard DELETE in production for clinical data.
//
// 2. AUDITING (Immutability - Law 26.529)
//    - Prepare AuditLog table: { id, entityName, entityId,
//      action (CREATE/UPDATE/DELETE), payload Json,
//      userId, createdAt }
//    - AuditLog is APPEND-ONLY: no updates, no soft-delete.
//    - Implement via Prisma middleware in src/index.ts
//
// 3. STANDARD TIMESTAMPS
//    - Every model includes: createdAt DateTime @default(now())
//    - Every model includes: updatedAt DateTime @updatedAt
//    - Every model includes: deletedAt DateTime?
//
// 4. DISCRIMINATED UNIONS
//    - For complex states (e.g. medical appointment) use `status` field
//      with Prisma enum. Business states are modeled as Discriminated Unions in TypeScript
//      derived from the Prisma enum.
//
// 5. PRISMA TYPES
//    - To infer query payload types use:
//        Prisma.<Model>GetPayload<{ include: { ... } }>
//        Awaited<ReturnType<typeof prismaClient.<model>.findUnique>>
//    - FORBIDDEN: Prisma.PromiseReturnType (does not exist in Prisma 5+)
//
// ============================================================
// DOMAIN MODELS
// ============================================================

model Patient {
  id                    String    @id @default(cuid())

  // Personal data
  firstName             String    @db.VarChar(100)
  lastName              String    @db.VarChar(100)
  documentType          String    @db.VarChar(10)   @default("DNI")
  documentNumber        String    @db.VarChar(20)
  dateOfBirth           DateTime
  biologicalSex         String    @db.VarChar(10)

  // Optional clinical data
  bloodGroup            String?   @db.VarChar(5)

  // Health Insurance / Obra Social
  healthInsurance       String?   @db.VarChar(100)
  healthInsurancePlan   String?   @db.VarChar(50)
  healthInsuranceNumber String?   @db.VarChar(50)

  // Primary guardian
  guardianFullName      String    @db.VarChar(200)
  guardianPhone         String    @db.VarChar(30)
  guardianEmail         String?   @db.VarChar(200)
  guardianRelationship  String    @db.VarChar(20)

  // Perinatal background
  birthWeightGrams      Int?
  gestationalWeeks      Int?
  apgarScore            String?   @db.VarChar(10)

  // Standard timestamps (Global Architecture)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@map("patients")
}


